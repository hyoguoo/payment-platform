{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/lint-file.sh",
            "timeout": 60,
            "statusMessage": "편집 파일 린트"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/verify-on-stop.sh",
            "timeout": 1200,
            "statusMessage": "변경 모듈 단위 테스트 검증"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementer",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/verify-on-stop.sh",
            "timeout": 1200,
            "statusMessage": "변경 모듈 단위 테스트 검증"
          }
        ]
      }
    ]
  }
}
