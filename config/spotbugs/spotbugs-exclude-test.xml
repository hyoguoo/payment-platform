<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!--
        Mockito BDD verification pattern: then(mock).should(never()).method()
        SpotBugs incorrectly flags the method call's return value as ignored.
        This is intentional — the call is part of Mockito's verification proxy chain.
    -->
    <Match>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
        <Class name="~.*Test"/>
    </Match>

    <!--
        Concurrency integration tests use catch(Exception ignored) inside Executor lambdas
        to tolerate expected thread-level failures (e.g., idempotency conflicts).
        The test asserts correctness via counters / DB state after all threads complete.
    -->
    <Match>
        <Bug pattern="DE_MIGHT_IGNORE"/>
        <Class name="~.*ConcurrencyIntegrationTest"/>
    </Match>

    <!--
        product-service 코틀린 이관 중 임시 제외. 코틀린 포트 StockRepository.findByProductId(Long?) 의 @Nullable 을
        자바 테스트 Fake 가 물려받아, null 을 받지 않는 맵 조회가 지적된다. 단위 테스트는 null 을 넘기지 않는다.
        이 Fake 를 코틀린으로 옮기면 이 항목을 지운다(docs/topics/KOTLIN-PILOT-PRODUCT/DESIGN.md T12).
    -->
    <Match>
        <Bug pattern="NP_PARAMETER_MUST_BE_NONNULL_BUT_MARKED_AS_NULLABLE"/>
        <Class name="com.hyoguoo.paymentplatform.product.mock.FakeStockRepository"/>
        <Method name="findByProductId"/>
    </Match>

    <!--
        product-service 코틀린 이관 중 임시 제외. 코틀린 ProductEntity.id(Long?, 저장 전에는 비어 있음)를 저장 직후
        읽어 StockEntity 생성자(Long)로 넘기는 자바 테스트 픽스처 줄이 지적된다. 저장 뒤라 id 는 항상 있다.
        이 테스트를 코틀린으로 옮기면 이 항목을 지운다(docs/topics/KOTLIN-PILOT-PRODUCT/DESIGN.md T12).
    -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
        <Class name="com.hyoguoo.paymentplatform.product.infrastructure.repository.ProductRepositoryImplPageTest"/>
        <Method name="saveProductWithStock"/>
    </Match>

</FindBugsFilter>
